{
  "manifest_version": 3,
  "name": "AuraFocus",
  "version": "1.0",
  "description": "Dynamic context-aware distraction management utilizing Gemini 2.5 Flash.",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ]
}
